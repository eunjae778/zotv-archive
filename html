<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>ZOTV Archive</title>
<meta name="description" content="Behind-the-scenes archive for ZOTV (Zenith of the Void) — production notes, concept art, pre-match interviews, and fun facts from Episode 1.">
<meta property="og:title" content="ZOTV Archive">
<meta property="og:description" content="Behind-the-scenes lore and production notes for ZOTV (Zenith of the Void).">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700&family=Spectral:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0D1220;
    --panel: #141B30;
    --panel-alt: #1B2440;
    --ink: #E9E6DC;
    --muted: #8A93AE;
    --gold: #C9A24B;
    --violet: #8577C2;
    --line: rgba(233,230,220,0.14);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: env(safe-area-inset-top, 0px);
  }
  :root {
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Spectral', serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  .wrap { max-width: 640px; margin: 0 auto; padding: 0 22px; }

  /* Stickers */
  .sticker-zone { position: relative; }
  .sticker {
    position: absolute;
    width: 86px;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 6px 10px rgba(0,0,0,0.45));
    z-index: 2;
  }

  /* Net motif */
  .net {
    height: 14px;
    background-image:
      repeating-linear-gradient(90deg, var(--line) 0, var(--line) 1px, transparent 1px, transparent 18px),
      linear-gradient(var(--line), var(--line));
    background-size: 100% 1px, 100% 1px;
    background-position: top, bottom;
    background-repeat: repeat, no-repeat;
    opacity: 0.9;
  }

  /* Hero */
  header.hero {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .filecode {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--gold);
    margin-bottom: 18px;
  }
  h1.hero-title {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 0.98;
    letter-spacing: 0.01em;
    max-width: 11ch;
    margin-bottom: 18px;
  }
  .hero-sub {
    color: var(--muted);
    font-size: 16.5px;
    max-width: 34ch;
    font-style: italic;
  }

  /* chip nav */
  nav.chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    scrollbar-width: none;
  }
  nav.chips::-webkit-scrollbar { display: none; }
  nav.chips a {
    flex: 0 0 auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--line);
    padding: 7px 12px;
    border-radius: 3px;
    white-space: nowrap;
  }
  nav.chips a:hover, nav.chips a:focus-visible { color: var(--ink); border-color: var(--gold); }

  section { padding: 46px 0; border-bottom: 1px solid var(--line); }
  section:last-of-type { border-bottom: none; }

  .section-head { margin-bottom: 26px; }
  .section-head .filecode { margin-bottom: 8px; }
  h2 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 600;
    font-size: 28px;
    letter-spacing: 0.01em;
  }
  .section-desc { color: var(--muted); font-size: 15px; max-width: 42ch; margin-top: 6px; }

  /* Timeline (production log) - numbered because it IS a sequence */
  .log-item {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .log-item:first-child { border-top: none; }
  .log-num {
    font-family: 'IBM Plex Mono', monospace;
    color: var(--gold);
    font-size: 13px;
    padding-top: 2px;
  }
  .log-title {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 5px;
  }
  .log-body { color: var(--ink); font-size: 15px; opacity: 0.9; }

  /* Dossier folders (cast & crew) - distinct treatment, not identical cards */
  .dossier {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--violet);
    padding: 18px 18px 18px 20px;
    margin-bottom: 14px;
  }
  .dossier + .dossier { margin-top: 14px; }
  .dossier-name {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 20px;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .dossier-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }
  .dossier-body { font-size: 14.5px; color: var(--muted); margin-top: 8px; }
  .dossier-body em { color: var(--ink); font-style: normal; }

  /* In-world archive - stat-card feel */
  .archive-card {
    background: var(--panel-alt);
    border: 1px solid var(--line);
    padding: 20px;
    margin-bottom: 14px;
  }
  .archive-card .filecode { color: var(--violet); margin-bottom: 10px; }
  .archive-card h3 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .archive-card p { font-size: 14.5px; color: var(--muted); }
  .redacted {
    display: inline-block;
    background: var(--ink);
    color: var(--ink);
    border-radius: 2px;
    padding: 0 4px;
  }

  /* Fun facts - not a sequence, no numbers */
  .facts { display: flex; flex-direction: column; }
  .fact {
    padding: 16px 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 6px 1fr;
    gap: 14px;
  }
  .fact:first-child { border-top: none; }
  .fact::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--gold);
    margin-top: 8px;
  }
  .fact p { font-size: 15px; }
  .fact strong { color: var(--gold); font-weight: 500; }

  /* Episode video placeholder */
  .video-slot {
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--line);
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
  }
  .video-slot iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Interview transcripts */
  .transcript {
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 20px 20px 6px;
    margin-bottom: 22px;
  }
  .transcript-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }
  .transcript-head h3 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 21px;
    font-weight: 600;
  }
  .transcript-head span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--muted);
  }
  .qa { padding-bottom: 16px; }
  .qa .q { color: var(--gold); font-size: 14px; font-style: normal; margin-bottom: 5px; }
  .qa .a { font-size: 15px; color: var(--ink); }
  .qa .a.aside { color: var(--muted); font-style: italic; }

  /* Concept art placeholders */
  .art-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .art-slot {
    aspect-ratio: 3 / 4;
    background: var(--panel-alt);
    border: 1px solid var(--line);
    display: flex;
    align-items: flex-end;
    padding: 10px;
    position: relative;
  }
  .art-slot.wide {
    aspect-ratio: 16 / 9;
  }
  .art-slot::before {
    content: "+";
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -60%);
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 30px;
    color: var(--muted);
    opacity: 0.5;
  }
  .art-slot .art-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    z-index: 1;
  }
  .art-piece.wide { grid-column: 1 / -1; }
  .art-slot.filled::before { content: none; }
  .art-slot.filled {
    padding: 0;
    overflow: hidden;
  }
  .art-slot.filled {
    background: #0A0E1B;
  }
  .art-slot.filled img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .art-comment {
    font-family: 'Spectral', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--muted);
    border-left: 2px solid var(--line);
    padding: 7px 0 2px 10px;
    margin-top: 8px;
  }

  .watermark {
    position: fixed;
    bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    left: calc(10px + env(safe-area-inset-left, 0px));
    width: 130px;
    opacity: 0.45;
    pointer-events: none;
    z-index: 50;
  }

  footer {
    padding: 34px 0 50px;
    color: var(--muted);
    font-size: 13px;
    font-family: 'IBM Plex Mono', monospace;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
</head>
